#!/bin/sh /etc/rc.common
# tg-bot демон: мгновенный Telegram-бот управления

START=99
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/tg-bot.sh
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
}
